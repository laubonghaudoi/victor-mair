---
import '../styles/global.css';
import { siteConfig, seo } from '../data/config';
import { nav } from '../data/memorial';
import { footer as foot } from '../data/prose';

interface Props {
  title: string;
  description?: string;
}

const { title, description = seo.description } = Astro.props;
const ogImage = new URL(seo.ogImage, seo.siteUrl).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: seo.person.name,
  alternateName: seo.person.alternateName,
  birthDate: seo.person.birthDate,
  birthPlace: { '@type': 'Place', name: seo.person.birthPlace },
  deathDate: seo.person.deathDate,
  deathPlace: { '@type': 'Place', name: seo.person.deathPlace },
  jobTitle: seo.person.jobTitle,
  knownFor: [
    'The Tarim Mummies',
    'Wandering on the Way',
    'The True History of Tea',
    'Painting and Performance',
  ],
  sameAs: seo.person.sameAs,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#2e211a" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={`${seo.siteUrl}/`} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={seo.siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={`${seo.siteUrl}/`} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={seo.ogImageAlt} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter / link previews -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="" />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400&family=Noto+Serif+TC:wght@300;400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body data-motion={siteConfig.motion} data-archival-tone={siteConfig.archivalTone}>
    <div class="m-progress" data-progress=""></div>

    <header class="m-header" data-header="">
      <div class="m-header__inner">
        <a href="#top" class="m-brand" data-brand="">
          <span class="m-brand__en">Victor H. Mair</span>
          <span class="m-brand__zh">梅維恆</span>
        </a>
        <nav class="m-nav" aria-label="Chapters">
          {
            nav.map((item) => (
              <a href={`#${item.id}`} data-navlink={item.id}>
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <main id="top">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-footer__inner">
        <div class="site-footer__grid">
          <div>
            <div class="site-footer__name">{foot.name}</div>
            <div class="site-footer__meta">
              <span class="site-footer__zh">{foot.zh}</span>
              <span class="site-footer__years">{foot.years}</span>
            </div>
          </div>
          <div>
            <p class="site-footer__bio">{foot.bio}</p>
            <p class="site-footer__quote" set:html={foot.quote} />
            <a class="site-footer__tribute" href="#ch7">
              {foot.tribute}
            </a>
          </div>
        </div>
        <div class="site-footer__bar">
          <span class="site-footer__note">{foot.barNote}</span>
          <a class="site-footer__top" href="#top">
            {foot.barTop}
          </a>
        </div>
      </div>
    </footer>

    <script src="../scripts/memorial.ts" />
  </body>
</html>
