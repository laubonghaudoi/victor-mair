---
import BaseLayout from '../layouts/BaseLayout.astro';
import Counter from '../components/Counter.tsx';
---

<BaseLayout title="Victor Mair">
  <main class="mx-auto flex min-h-screen max-w-2xl flex-col items-center justify-center gap-8 px-6 text-center">
    <p class="text-sm font-medium uppercase tracking-[0.2em] text-sky-400">
      Astro 7 · React 19 · Tailwind CSS 4
    </p>
    <h1 class="text-5xl font-bold tracking-tight">
      Hello, <span class="text-sky-400">world</span>
    </h1>
    <p class="text-lg text-slate-400">
      This static site is ready to build on. Edit
      <code class="rounded bg-slate-800 px-1.5 py-0.5 text-sm text-sky-300">src/pages/index.astro</code>
      to make it yours.
    </p>
    <Counter client:load />
  </main>
</BaseLayout>
