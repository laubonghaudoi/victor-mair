---
import type { CVEntry } from '../data/mair';

interface Props {
  items: CVEntry[];
}
const { items } = Astro.props;
---

<dl class="divide-y divide-parchment-deep">
  {
    items.map((entry) => (
      <div class="grid gap-1 py-3 sm:grid-cols-[9rem_1fr] sm:gap-6">
        <dt class="font-display text-sm font-semibold uppercase tracking-wide text-gilt sm:pt-0.5">
          {entry.years}
        </dt>
        <dd class="text-[1.05rem] leading-snug text-ink">
          {entry.link ? (
            <a
              href={entry.link}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-gilt hover:underline"
            >
              {entry.detail}
            </a>
          ) : (
            entry.detail
          )}
        </dd>
      </div>
    ))
  }
</dl>
