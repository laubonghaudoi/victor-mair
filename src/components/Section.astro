---
interface Props {
  id: string;
  eyebrow?: string;
  title: string;
  lead?: string;
}
const { id, eyebrow, title, lead } = Astro.props;
---

<section id={id} class="scroll-mt-20 border-t border-parchment-deep py-16 sm:py-20">
  <div class="mx-auto max-w-3xl px-6">
    {eyebrow && (
      <p class="mb-2 text-xs font-semibold uppercase tracking-[0.2em] text-gilt">{eyebrow}</p>
    )}
    <h2 class="font-display text-3xl text-ink sm:text-4xl">{title}</h2>
    {lead && <p class="mt-4 text-lg leading-relaxed text-ink-soft">{lead}</p>}
    <div class="mt-8">
      <slot />
    </div>
  </div>
</section>
