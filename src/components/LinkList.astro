---
import type { LinkItem } from '../data/mair';

interface Props {
  items: LinkItem[];
}
const { items } = Astro.props;
---

<ul class="divide-y divide-parchment-deep">
  {
    items.map((item) => (
      <li class="py-3">
        {item.url && item.url !== '#' ? (
          <a
            href={item.url}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-baseline justify-between gap-4 text-ink"
          >
            <span class="text-[1.05rem] leading-snug group-hover:text-gilt group-hover:underline">
              {item.title}
            </span>
            <span class="shrink-0 text-sm text-gilt-soft transition-transform group-hover:translate-x-0.5">
              ↗
            </span>
          </a>
        ) : (
          <span class="text-[1.05rem] leading-snug text-ink-soft">{item.title}</span>
        )}
        {item.note && <span class="ml-2 text-sm italic text-ink-soft/70">({item.note})</span>}
      </li>
    ))
  }
</ul>
